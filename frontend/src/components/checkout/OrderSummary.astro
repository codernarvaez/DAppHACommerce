---
import './OrderSummary.css'

import { 
    getI18n,
    resolveLocale,
    readConsent 
} from '../../lib/i18n';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

interface Props {
    items: Array<{
    id: string;
    name: string;
    quantity: number;
    price: number;
    estado?: string;
    eudrApproved?: boolean;
    primas?: number;
    peso?: number;
    }>;
    subtotal: number;
    taxRate?: number; // 0.15
    discount?: { code: string; amount: number };
}

const ESTADO_LABELS: Record<string, string> = {
  'RECEPCION': 'Recepción',
  'EN_TRILLA': 'En Trilla',
  'EN_SECADO': 'En Secado',
  'EN_BODEGA': 'En Bodega',
  'TOSTADO': 'Tostado',
  'MOLIDO': 'Molido',
  'DESPACHADO': 'Despachado',
};

const {
    items = [],
    subtotal = 0,
    taxRate = 0.15, //IVA 15%
    discount = null
} = Astro.props;

const tax = subtotal * taxRate;
const discountAmount = discount?.amount || 0;
const total = subtotal + tax - discountAmount;
---

<aside class="order-summary" aria-label="Resumen del pedido">
    <div class="order-summary__card">
        <header class="order-summary__header">
            <h2 class="order-summary__title">{m.checkout.orderSummary.title}</h2>
        </header>

        <ul class="order-summary__items">
            {items.map((item) => (
                <li class="order-item">
                    <div class="order-item__details">
                        <p class="order-item__name">{item.name}</p>
                        <div class="order-item__meta-grid">
                            {item.estado && (
                                <span class="order-item__meta">
                                    <span class="meta-label">{m.checkout.orderSummary.estado}</span>
                                    <span class={`estado-chip estado-${item.estado}`}>
                                        {ESTADO_LABELS[item.estado] || item.estado}
                                    </span>
                                </span>
                            )}
                            {item.peso && item.peso > 0 && (
                                <span class="order-item__meta">
                                    <span class="meta-label">{m.checkout.orderSummary.peso}</span>
                                    <span>{item.peso} kg</span>
                                </span>
                            )}
                            {item.primas && item.primas > 0 && (
                                <span class="order-item__meta">
                                    <span class="meta-label">{m.checkout.orderSummary.primas}</span>
                                    <span>+ ${item.primas.toFixed(2)}</span>
                                </span>
                            )}
                            {item.eudrApproved && (
                                <span class="order-item__meta order-item__meta--eudr">
                                    <span class="meta-label">{m.checkout.orderSummary.eudr}</span>
                                    <span class="eudr-badge">✓ {m.checkout.orderSummary.eudrApproved}</span>
                                </span>
                            )}
                        </div>
                    </div>
                </li>
            ))}
        </ul>

        <div class="order-summary__breakdown">
            <dl class="price-row">
                <dt>{m.checkout.orderSummary.subtotal}</dt>
                <dd>${subtotal.toFixed(2)}</dd>
            </dl>
            <dl class="price-row">
                {m.checkout.orderSummary.tax.replace(
                    '{rate}',
                    String(Math.round(taxRate * 100))
                )}
                <dd>${tax.toFixed(2)}</dd>
            </dl>
            {discount && (
                <dl class="price-row price-row--discount">
                    <dt>
                        {m.checkout.orderSummary.discount.replace(
                            '{code}',
                            discount.code
                        )}
                    </dt>
                    <dd>-${discount.amount.toFixed(2)}</dd>
                </dl>
            )}
            <dl class="price-row price-row--total">
                <dt>{m.checkout.orderSummary.total}</dt>
                <dd>${total.toFixed(2)}</dd>
            </dl>
        </div>

    </div>
</aside>