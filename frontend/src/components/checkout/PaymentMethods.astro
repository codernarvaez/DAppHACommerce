---

interface PaymentMethod {
    id: string;
    name: string;
    description: string;
    icon: string;
    fee: string;
    available: boolean;
}

interface Props {
    methods: PaymentMethod[];
    selectedMethod?: string;
}

---

<!-- Payment Methods Selection -->
<div class="payment-methods">
    <div class="payment-header">
        <h2>Pasarela de Pagos Avanzada</h2>
        <p>Selecciona su método de pago preferido para procesar la transacción de forma segura.</p>
    </div>

    <div class="payment-grid">
        <!-- Method: Card -->
        <button class="payment-card" id="btn-card" data-method="card">
            <div class="payment-icon">💳</div>
            <div class="payment-info">
                <h3>TARJETA</h3>
                <p class="payment-description">Crédito o Débito</p>
            </div>
        </button>

        <!-- Method: Bank Transfer -->
        <button class="payment-card" id="btn-bank" data-method="bank">
            <div class="payment-icon">🏦</div>
            <div class="payment-info">
                <h3>TRANSFERENCIA</h3>
                <p class="payment-description">Banca Nacional</p>
            </div>
        </button>

        <!-- Method: Web3 -->
        <button class="payment-card" id="btn-web3" data-method="web3">
            <div class="payment-icon">₿</div>
            <div class="payment-info">
                <h3>WEB3 / DEX</h3>
                <p class="payment-description">Crypto Wallet</p>
            </div>
        </button>
    </div>
</div>

<!-- Payment Forms Container -->
<div class="payment-forms-container">
    <!-- Card Form -->
    <div class="payment-form" id="form-card">
        <div class="form-header">
            <h3>Datos de la Tarjeta</h3>
        </div>

        <div class="form-grid">
            <!-- Card Holder Name -->
            <div class="form-group full-width">
                <label for="card-holder">TITULAR DE LA TARJETA</label>
                <input
                    id="card-holder"
                    type="text"
                    placeholder="NOMBRE COMPLETO"
                    class="form-input"
                />
            </div>

            <!-- Card Number -->
            <div class="form-group full-width">
                <label for="card-number">NÚMERO DE TARJETA</label>
                <div class="input-with-icon">
                    <input
                        id="card-number"
                        type="text"
                        placeholder="0000 0000 0000 0000"
                        class="form-input"
                        maxlength="19"
                    />
                    <span class="input-icon">credit_card</span>
                </div>
            </div>

            <!-- Expiration & CVC -->
            <div class="form-group">
                <label for="card-expiry">EXPIRACIÓN</label>
                <input
                    id="card-expiry"
                    type="text"
                    placeholder="MM / AA"
                    class="form-input"
                    maxlength="5"
                />
            </div>

            <div class="form-group">
                <label for="card-cvc">CVC / CVV</label>
                <input
                    id="card-cvc"
                    type="password"
                    placeholder="***"
                    class="form-input"
                    maxlength="4"
                />
            </div>
        </div>

        <!-- Save Card Checkbox -->
        <div class="form-checkbox">
            <input
                id="save-card"
                type="checkbox"
                class="checkbox-input"
            />
            <label for="save-card">Guardar esta tarjeta para futuras compras.</label>
        </div>
    </div>

    <!-- Bank Transfer Form -->
    <div class="payment-form hidden" id="form-bank">
        <div class="form-header">
            <h3>Transferencia Bancaria</h3>
        </div>

        <div class="bank-info">
            <div class="bank-row">
                <span class="bank-label">BANCO</span>
                <span class="bank-value">Origin Bank International</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">CUENTA (IBAN)</span>
                <span class="bank-value">ES91 2100 0451 9002 0012 3456</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">REFERENCIA</span>
                <span class="bank-value bank-reference">#ORD-99201-OT</span>
            </div>
        </div>

        <div class="bank-note">
            <p><strong>Nota:</strong> El pedido se procesará una vez confirmada la recepción de los fondos (aprox. 24-48h).</p>
        </div>
    </div>

    <!-- Web3 Form -->
    <div class="payment-form hidden" id="form-web3">
        <div class="web3-container">
            <div class="web3-qr">
                <span class="web3-icon">qr_code_2</span>
            </div>
            <h3 class="web3-title">Connect your Wallet</h3>
            <p class="web3-description">
                Soportamos MetaMask, WalletConnect y Phantom. Transacción nativa en USDC, USDT o ETH.
            </p>
            <button class="web3-button">
                <span class="web3-button-icon">account_balance_wallet</span>
                CONNECT WALLET
            </button>
        </div>
    </div>

	<!-- Payment Confirmation -->
	<div class="payment-footer">
		<div class="payment-security">
			<span class="security-icon">verified_user</span>
			<span class="security-text">CONEXIÓN CIFRADA DE 256 BITS</span>
		</div>
		<button class="payment-confirm-btn">
			CONFIRMAR Y PAGAR
		</button>
	</div>
</div>

<style>
    :root {
        --color-on-surface: #121212;
        --color-on-surface-variant: #666;
        --color-outline: #999; /* icons */
        --color-surface-soft: rgba(18, 18, 18, 0.06);
        --color-secundary: #0d6f66;
        --color-white: #ffffff;

    }

	:global(html) {
		scroll-behavior: smooth;
		background: #f4f1eb;
	}

	:global(body) {
		font-family: 'Manrope', sans-serif;
		background:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.9), rgba(244, 241, 235, 0.96) 40%),
			linear-gradient(180deg, #f7f3ee 0%, #f1eee8 100%);
		color: var(--color-on-surface);
	}

	.payment-header {
		font-family: 'Space Grotesk', sans-serif;
	}

    /* Forms Container */
    .payment-forms-container {
        margin-top: 32px;
        padding: 24px;
        background: rgba(255, 255, 255, 0.72);
        border: 2px solid var(--color-surface-soft);
        border-radius: 18px;
        min-height: 320px;
    }

    .form-header {
        margin-bottom: 20px;
        border-bottom: 1px solid var(--color-surface-soft);
        padding-bottom: 16px;
    }

    .form-header h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0;
    }

	.payment-grid {
		display: flex;
		flex-direction: row;
		gap: 20px;
		width: 100%;
	}  

	.payment-card {
		font-family: 'Space Grotesk', sans-serif;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		width: 100%;
		padding: 18px 22px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.78rem;
		background: var(--color-surface-soft);
		backdrop-filter: blur(18px);
		border: 1px solid var(--color-surface-soft);
		cursor: pointer;
		transition: all 0.3s ease;
		text-align: left;
	}

	.payment-card:hover {
		border-color: var(--color-outline);
		box-shadow: 0 8px 24px var(--color-outline);
		transform: translateY(-2px);
	}

	.payment-card.selected {
		border-color: var(--color-on-surface);
		background:  rgba(255, 255, 255, 0.72);
	}

    /* Form Inputs */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input {
        padding: 12px 16px;
        border: 1px solid var(--color-surface-soft);
        border-radius: 8px;
        font-size: 14px;
        background: var(--color-white);
        transition: all 0.3s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: var(--color-secundary);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1);
    }

    .input-with-icon {
        position: relative;
        display: flex;
    }

    .input-with-icon .form-input {
        flex: 1;
        padding-right: 40px;
    }

    .input-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 20px;
        color: var(--color-outline);
        pointer-events: none;
    }

    /* Checkbox */
    .form-checkbox {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
    }

    .checkbox-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--color-secundary);
    }

    .form-checkbox label {
        font-size: 14px;
        color: var(--color-on-surface-variant);
        cursor: pointer;
        margin: 0;
    }

    /* Bank Transfer Form */
    .bank-info {
		background: var(--color-surface-soft);
		border: 1px solid var(--color-surface-soft);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 16px;
    }

    .bank-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(34, 197, 94, 0.1);
        align-items: center;
    }

    .bank-row:last-child {
        border-bottom: none;
    }

    .bank-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--color-on-surface);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .bank-value {
        font-size: 14px;
        font-weight: 500;
        color: var(--color-on-surface);
    }

    .bank-reference {
        font-weight: 700;
        color: var(--color-on-surface);
    }

    .bank-note {
        padding: 16px;
        background: rgba(241, 245, 241, 0.8);
        border-radius: 8px;
        font-size: 13px;
        color: var(--color-on-surface-variant);
        font-style: italic;
        line-height: 1.6;
    }

    .bank-note p {
        margin: 0;
    }

    /* Web3 Form */
    .web3-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        text-align: center;
    }

    .web3-qr {
        width: 128px;
        height: 128px;
        display: flex;
        align-items: center;
        justify-content: center;
		background: var(--color-surface-soft);
		border: 1px solid var(--color-surface-soft);
        border-radius: 16px;
        margin-bottom: 24px;
    }

    .web3-icon {
        font-size: 64px;
        color: var(--color-on-surface);
    }

    .web3-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-on-surface);
        margin: 0 0 12px 0;
    }

    .web3-description {
        font-size: 14px;
        color: var(--color-on-surface-variant);
        max-width: 400px;
        margin: 0 auto 24px;
        line-height: 1.5;
    }

    .web3-button {
        padding: 12px 24px;
        background: var(--color-secundary);
        color: var(--color-white);
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .web3-button:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    .web3-button-icon {
        font-size: 20px;
    }

    /* Payment Footer */
    .payment-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--color-on-surface);
        gap: 16px;
        flex-wrap: wrap;
    }

    .payment-security {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-on-surface-variant);
        text-transform: uppercase;
    }

    .security-icon {
        font-size: 20px;
        color: var(--color-secundary);
    }

    .payment-confirm-btn {
        padding: 12px 32px;
        background: var(--color-on-surface);
        color: var(--color-white);
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 180px;
    }

    .payment-confirm-btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px var(--color-on-surface);
    }

    .payment-confirm-btn:active {
        transform: scale(0.95);
    }

    /* Form Visibility */
    .payment-form {
        display: none;
    }

    .payment-form.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .payment-grid {
			flex-direction: column;
		}
		.form-grid {
            grid-template-columns: 1fr;
        }

        .payment-footer {
            flex-direction: column;
        }

        .payment-confirm-btn {
            width: 100%;
        }

        .payment-security {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		selectPaymentMethod('card');
	});

    // Payment method selection
    document.querySelectorAll('[data-method]').forEach((btn) => {
        const button = btn as HTMLElement;
        button.addEventListener('click', () => {
            const method = button.getAttribute('data-method');
            selectPaymentMethod(method || '');
        });
    });

    function selectPaymentMethod(method: string) {
        // Hide all forms
        document.querySelectorAll('.payment-form').forEach((form) => {
            form.classList.remove('active');
        });

        // Show selected form
        const form = document.getElementById(`form-${method}`);
        if (form) {
            form.classList.add('active');
        }

        // Update button states
        document.querySelectorAll('[data-method]').forEach((btn) => {
            const button = btn as HTMLElement;
            const isSelected = button.getAttribute('data-method') === method;
            if (isSelected) {
                button.classList.add('selected');
            } else {
                button.classList.remove('selected');
            }
        });
    }

    // Format card number
    const cardNumberInput = document.getElementById('card-number') as HTMLInputElement;
    if (cardNumberInput) {
        cardNumberInput.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            let value = target.value.replace(/\s/g, '');
            let formatted = value.match(/.{1,4}/g)?.join(' ') || value;
            target.value = formatted;
        });
    }

    // Format expiry (MM/AA)
    const expiryInput = document.getElementById('card-expiry') as HTMLInputElement;
    if (expiryInput) {
        expiryInput.addEventListener('input', (e) => {
            const target = e.target as HTMLInputElement;
            let value = target.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.slice(0, 2) + ' / ' + value.slice(2, 4);
            }
            target.value = value;
        });
    }
</script>