---
import './PaymentMethods.css'
import { Icon } from 'astro-icon/components';

import { 
    getI18n,
    resolveLocale,
    readConsent 
} from '../../lib/i18n';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

interface PaymentMethod {
    id: string;
    name: string;
    description: string;
    icon: string;
    fee: string;
    available: boolean;
}

interface Props {
    methods: PaymentMethod[];
    selectedMethod?: string;
    stripePublicKey?: string;
    total?: number;
}

const { methods, selectedMethod = 'card', stripePublicKey = '', total = 0 } = Astro.props;

---

<!-- Payment Methods Selection -->
<div class="payment-methods" data-stripe-key={stripePublicKey} data-total={total}>
    <div class="payment-header">
        <h2>{m.checkout.paymentMethods.title}</h2>
        <p>{m.checkout.paymentMethods.subtitle}</p>
    </div>

    <div class="payment-grid">
        <!-- Method: Card -->
        <button class="payment-card" id="btn-card" data-method="card">
            <div class="payment-icon">
                <Icon name="card-outline" class="icon"/>
            </div>
            <div class="payment-info">
                <h3>{m.checkout.paymentMethods.card}</h3>
                <p class="payment-description">{m.checkout.paymentMethods.cardDesc}</p>
            </div>
        </button>

        <!-- Method: Bank Transfer -->
        <button class="payment-card" id="btn-bank" data-method="bank">
            <div class="payment-icon">
                <Icon name="bank" class="icon"/>
            </div>
            <div class="payment-info">
                <h3>{m.checkout.paymentMethods.bank}</h3>
                <p class="payment-description">{m.checkout.paymentMethods.bankDesc}</p>
            </div>
        </button>

        <!-- Method: Web3 -->
        <button class="payment-card" id="btn-web3" data-method="web3">
            <div class="payment-icon">
                <Icon name="bitcoin" class="icon"/>
            </div>
            <div class="payment-info">
                <h3>{m.checkout.paymentMethods.crypto}</h3>
                <p class="payment-description">{m.checkout.paymentMethods.cryptoDesc}</p>
            </div>
        </button>
    </div>
</div>

<!-- Payment Forms Container -->
<div class="payment-forms-container">
    <!-- Card Form -->
    <div class="payment-form" id="form-card">
        <div class="form-header">
            <h3>{m.checkout.paymentForms.card.title}</h3>
        </div>

        <div class="form-grid">
            <!-- Card Holder Name -->
            <div class="form-group full-width">
                <label for="card-holder">{m.checkout.paymentForms.card.cardHolder}</label>
                <input
                    id="card-holder"
                    type="text"
                    placeholder={m.checkout.paymentForms.card.cardHolderPlaceholder}
                    class="form-input"
                />
            </div>

            <!-- Stripe Card Element -->
            <div class="form-group full-width" style="margin-top: 16px;">
                <label for="card-element">Información de Tarjeta (Stripe Sandbox)</label>
                <div id="card-element" class="form-input" style="padding: 12px; background: white; border: 1px solid #d7dbd6; border-radius: 10px;">
                    <!-- Stripe Card Element will mount here -->
                </div>
                <div id="card-errors" role="alert" style="color: #b91c1c; font-size: 0.85rem; margin-top: 8px;"></div>
            </div>
        </div>

        <!-- Save Card Checkbox -->
        <div class="form-checkbox">
            <input
                id="save-card"
                type="checkbox"
                class="checkbox-input"
            />
            <label for="save-card">{m.checkout.paymentForms.card.saveCard}</label>
        </div>
    </div>

    <!-- Bank Transfer Form -->
    <div class="payment-form hidden" id="form-bank">
        <div class="form-header">
            <h3>{m.checkout.paymentForms.bank.bankFormSubtitle}</h3>
        </div>

        <div class="bank-info">
            <div class="bank-row">
                <span class="bank-label">{m.checkout.paymentForms.bank.label}</span>
                <span class="bank-value">Origin Bank International</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">{m.checkout.paymentForms.bank.account}</span>
                <span class="bank-value">ES91 2100 0451 9002 0012 3456</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">{m.checkout.paymentForms.bank.reference}</span>
                <span class="bank-value bank-reference">#ORD-99201-OT</span>
            </div>
        </div>

        <div class="bank-note">
            <p><strong>{m.checkout.paymentForms.bank.note}</strong>{m.checkout.paymentForms.bank.noteInfo}</p>
        </div>
    </div>

    <!-- Web3 Form -->
    <div class="payment-form hidden" id="form-web3">
        <div class="web3-container">
            <div class="web3-qr">
                <span class="web3-icon">qr_code_2</span>
            </div>
            <h3 class="web3-title">{m.checkout.paymentForms.web3.title}</h3>
            <p class="web3-description">
                {m.checkout.paymentForms.web3.description}
            </p>
            <button class="web3-button">
                <span class="web3-button-icon">
                    <Icon name="wallet" class="icon"/>
                </span>
                {m.checkout.buttons.connectWallet}
            </button>
        </div>
    </div>

	<!-- Payment Confirmation -->
	<div class="payment-footer">
		<div class="payment-security">
			<span class="security-icon">
                <Icon name="verified-user" class="icon"/>
            </span>
			<span class="security-text">{m.checkout.security}</span>
		</div>
		<button class="payment-confirm-btn">
			{m.checkout.buttons.confirmPay}
		</button>
	</div>
</div>

<!-- Transaction Status Modal -->
<div class="status-modal-overlay" id="payment-status-modal">
    <div class="status-modal-card">
        <div class="status-icon-wrapper" id="modal-status-icon">
            <!-- Icon mounted dynamically -->
        </div>
        <h2 id="modal-status-title">Estado de Pago</h2>
        <p id="modal-status-message">Tu transacción se está procesando.</p>
        <button class="status-modal-btn" id="modal-close-btn">Aceptar</button>
    </div>
</div>

<script>
    import { supabase } from '../../lib/supabase';

    const getCookie = (name: string) => {
        const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? decodeURIComponent(match[2]) : null;
    };

    const getAuthToken = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.access_token) {
            return session.access_token;
        }
        return getCookie('geoguard_token') || localStorage.getItem('geoguard_token');
    };

    // State
    let selectedMethod = 'card';
    let stripe: any = null;
    let cardElement: any = null;

    // Get parameters from container
    const container = document.querySelector('.payment-methods');
    const stripeKey = container?.getAttribute('data-stripe-key');
    const total = parseFloat(container?.getAttribute('data-total') || '0');

    document.addEventListener('DOMContentLoaded', () => {
        selectPaymentMethod('card');
        initializeStripe();
    });

    function initializeStripe() {
        if (!stripeKey) {
            console.error('Stripe public key is missing.');
            return;
        }

        const stripeObj = (window as any).Stripe;
        if (!stripeObj) {
            console.error('Stripe.js was not loaded.');
            return;
        }

        stripe = stripeObj(stripeKey);
        const elements = stripe.elements();

        const style = {
            base: {
                fontSize: '16px',
                color: '#121212',
                fontFamily: 'Manrope, sans-serif',
                '::placeholder': {
                    color: '#9ca3af',
                },
            },
            invalid: {
                color: '#b91c1c',
            },
        };

        cardElement = elements.create('card', { 
            style,
            disableLink: true 
        });
        cardElement.mount('#card-element');

        cardElement.on('change', (event: any) => {
            const displayError = document.getElementById('card-errors');
            if (displayError) {
                displayError.textContent = event.error ? event.error.message : '';
            }
        });
    }

    // Payment method selection
    document.querySelectorAll('[data-method]').forEach((btn) => {
        const button = btn as HTMLElement;
        button.addEventListener('click', () => {
            const method = button.getAttribute('data-method');
            selectedMethod = method || 'card';
            selectPaymentMethod(selectedMethod);
        });
    });

    function selectPaymentMethod(method: string) {
        // Hide all forms
        document.querySelectorAll('.payment-form').forEach((form) => {
            form.classList.remove('active');
        });

        // Show selected form
        const form = document.getElementById(`form-${method}`);
        if (form) {
            form.classList.add('active');
        }

        // Update button states
        document.querySelectorAll('[data-method]').forEach((btn) => {
            const button = btn as HTMLElement;
            const isSelected = button.getAttribute('data-method') === method;
            if (isSelected) {
                button.classList.add('selected');
            } else {
                button.classList.remove('selected');
            }
        });
    }

    // Handle Payment Confirmation
    const confirmBtn = document.querySelector('.payment-confirm-btn') as HTMLButtonElement;
    if (confirmBtn) {
        confirmBtn.addEventListener('click', async (e) => {
            e.preventDefault();

            if (selectedMethod !== 'card') {
                showStatusModal('error', 'Método no disponible', `El método de pago ${selectedMethod} no está integrado con pasarela real aún. Por favor utiliza Tarjeta.`);
                return;
            }

            if (!stripe || !cardElement) {
                showStatusModal('error', 'Error de Stripe', 'La pasarela de Stripe no está inicializada correctamente.');
                return;
            }

            const cardHolder = (document.getElementById('card-holder') as HTMLInputElement)?.value.trim();
            if (!cardHolder) {
                showStatusModal('error', 'Datos Faltantes', 'Por favor ingresa el nombre del titular de la tarjeta.');
                return;
            }

            // Disable button
            confirmBtn.disabled = true;
            confirmBtn.textContent = 'Procesando Pago...';
            const errorDisplay = document.getElementById('card-errors');
            if (errorDisplay) errorDisplay.textContent = '';

            try {
                // Get auth header value
                const token = await getAuthToken();
                const headers: Record<string, string> = {
                    'Content-Type': 'application/json',
                };
                if (token) {
                    headers['Authorization'] = `Bearer ${token}`;
                }

                // Request payment intent client secret
                const response = await fetch('/api/pagos/create-payment-intent', {
                    method: 'POST',
                    headers,
                    body: JSON.stringify({
                        monto: total,
                        moneda: 'usd',
                        direccion_envio: 'Dirección de entrega de pruebas'
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.detail || 'Error al crear el PaymentIntent en el servidor.');
                }

                const intentData = await response.json();
                const clientSecret = intentData.client_secret;

                // Confirm payment with Stripe
                const result = await stripe.confirmCardPayment(clientSecret, {
                    payment_method: {
                        card: cardElement,
                        billing_details: {
                            name: cardHolder
                        }
                    }
                });

                if (result.error) {
                    throw new Error(result.error.message);
                }

                if (result.paymentIntent.status === 'succeeded') {
                    showStatusModal('success', '¡Pago Exitoso!', 'Tu pedido ha sido procesado con éxito. Puedes ver los detalles en tu panel.');
                }
            } catch (err: any) {
                console.error(err);
                showStatusModal('error', 'Error en Transacción', err.message || 'Ocurrió un error inesperado al procesar el pago.');
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Confirmar y Pagar';
            }
        });
    }

    // Modal Control logic
    const modal = document.getElementById('payment-status-modal');
    const modalIcon = document.getElementById('modal-status-icon');
    const modalTitle = document.getElementById('modal-status-title');
    const modalMessage = document.getElementById('modal-status-message');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    let isSuccessRedirect = false;

    function showStatusModal(type: 'success' | 'error', title: string, message: string) {
        if (!modal || !modalIcon || !modalTitle || !modalMessage) return;

        // Reset classes
        modalIcon.className = 'status-icon-wrapper';
        
        if (type === 'success') {
            modalIcon.classList.add('success');
            modalIcon.innerHTML = '✓';
            isSuccessRedirect = true;
        } else {
            modalIcon.classList.add('error');
            modalIcon.innerHTML = '✗';
            isSuccessRedirect = false;
        }

        modalTitle.textContent = title;
        modalMessage.textContent = message;
        modal.classList.add('active');
    }

    if (modalCloseBtn) {
        modalCloseBtn.addEventListener('click', () => {
            modal?.classList.remove('active');
            if (isSuccessRedirect) {
                window.location.href = '/';
            }
        });
    }
</script>