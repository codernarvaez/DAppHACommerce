---

import { 
    getI18n,
    resolveLocale,
    readConsent 
} from '../../lib/i18n';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

interface Props {
  estado?: string;
}

const { estado = '' } = Astro.props;

// Build chronology steps dynamically based on the bodega estado
const ALL_STEPS = [
  { key: 'RECEPCION',  title: 'Recepción & Pesaje',    desc: 'Ingreso del café pergamino a bodega. Control de peso y humedad.' },
  { key: 'EN_SECADO',  title: 'Secado',                desc: 'Secado lento en camas africanas o patio para alcanzar humedad óptima (10-12%).' },
  { key: 'EN_TRILLA',  title: 'Trilla',                desc: 'Proceso mecánico de remoción del pergamino. Clasificación por tamaño y densidad.' },
  { key: 'EN_BODEGA',  title: 'Almacenamiento',        desc: 'Almacenamiento en bodega con control de temperatura y humedad.' },
  { key: 'TOSTADO',    title: 'Tostado',               desc: 'Tueste artesanal controlado para desarrollo óptimo de sabor.' },
  { key: 'MOLIDO',     title: 'Molienda',              desc: 'Molienda calibrada según perfil de preparación deseado.' },
  { key: 'DESPACHADO', title: 'Despacho',              desc: 'Empaque final y envío al comprador con trazabilidad completa.' },
];

// Determine which steps are completed based on the current estado
const currentIndex = ALL_STEPS.findIndex((s) => s.key === estado);

const steps = ALL_STEPS.map((step, index) => {
  let status = 'PENDIENTE';
  if (currentIndex >= 0) {
    if (index < currentIndex) status = 'COMPLETADO';
    else if (index === currentIndex) status = 'EN PROCESO';
  }
  return { ...step, status };
});
---

<div class="chronology-container">
  <h2>{m.productDetail.chronology}</h2>
  <div class="timeline">
    {steps.map((step) => (
      <div class:list={['timeline-item', { completed: step.status === 'COMPLETADO', active: step.status === 'EN PROCESO' }]}>
        <div class:list={['timeline-badge', { completed: step.status === 'COMPLETADO', active: step.status === 'EN PROCESO' }]}></div>
        <div class="timeline-content">
          <span class:list={['status', { 'status-completed': step.status === 'COMPLETADO', 'status-active': step.status === 'EN PROCESO' }]}>
            {step.status}
          </span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>

  .chronology-container {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 32px;
    margin-top: 32px;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    color: #111827;
  }
  .timeline {
    position: relative;
    padding-left: 24px;
    border-left: 2px solid #e5e7eb;
  }
  .timeline-item {
    position: relative;
    margin-bottom: 24px;
    opacity: 0.5;
  }
  .timeline-item.completed,
  .timeline-item.active {
    opacity: 1;
  }
  .timeline-item:last-child {
    margin-bottom: 0;
  }
  .timeline-badge {
    position: absolute;
    left: -31px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d1d5db;
    border: 2px solid #fff;
  }
  .timeline-badge.completed {
    background: #137333;
  }
  .timeline-badge.active {
    background: #f59e0b;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.2);
  }
  .status {
    font-size: 0.75rem;
    font-weight: bold;
    color: #9ca3af;
    text-transform: uppercase;
  }
  .status-completed {
    color: #137333;
  }
  .status-active {
    color: #f59e0b;
  }
  .timeline-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 4px 0;
    color: #111827;
  }
  .timeline-content p {
    font-size: 0.95rem;
    color: #4b5563;
  }
</style>