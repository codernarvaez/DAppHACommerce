---
import Layout from '../layouts/Layout.astro';
import BreadcrumbRadio from '../components/BreadcrumbRadio.astro';
import PurchasePanel from '../components/product-detail/PurchasePanel.astro';
import ProductionChronology from '../components/product-detail/ProductionChronology.astro';

import { 
    getI18n,
    resolveLocale,
    readConsent 
} from '../lib/i18n';

import { fetchPublicCatalogo } from '../lib/api/geoguard';
import type { CatalogoItem } from '../lib/api/geoguard';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

// Fetch real data based on bodegaId query param
const bodegaId = Astro.url.searchParams.get('bodegaId');

let title = 'Café — Detalle del Lote';
let description = '';
let price = '$0.00';
let stock = '0 kg';
let weight = '0 kg';
let eudrApproved = true;
let primas = 0;
let estado = 'EN_BODEGA';
let catalogoItem: CatalogoItem | null = null;

if (bodegaId) {
	try {
		const catalogoItems = await fetchPublicCatalogo();
		catalogoItem = catalogoItems.find((item) => item.id === bodegaId) || null;

		if (catalogoItem) {
			title = `Café ${catalogoItem.tipoCafe} — Lote ${catalogoItem.codigoLote}`;
			price = `$${Number(catalogoItem.precioReferencial).toFixed(2)}`;
			stock = `${catalogoItem.pesoDisponibleKg} kg`;
			weight = `${catalogoItem.pesoTotalKg} kg`;
			description = `Lote de café de variedad ${catalogoItem.tipoCafe} procesado mediante el método ${catalogoItem.proceso}. Peso total del lote: ${catalogoItem.pesoTotalKg} kg · Volumen disponible: ${catalogoItem.pesoDisponibleKg} kg.`;
		}
	} catch (err) {
		console.error('Error loading product detail:', err);
		description = 'Error al cargar datos del producto.';
	}
}

const checkoutSteps = [
  { label: m.checkoutSteps.detail, url: `/product-detail?bodegaId=${bodegaId || ''}` },
  { label: m.checkoutSteps.pay, url: `/checkout` },
];
---

<Layout locale={locale} title={`${title} - DApp HA Commerce`} description={description}>
  <main class="detail-container">
    <BreadcrumbRadio steps={checkoutSteps} currentStep={1} />

    <div class="main-grid">
      <section class="info-section">
        <div class="badge-row">
          <span class="estado-badge estado-EN_BODEGA">En Bodega</span>
          {eudrApproved && <span class="badge-origin">✓ EUDR Aprobado</span>}
        </div>
        <h1 class="product-title">{title}</h1>
        
        {catalogoItem && (
          <div class="muestra-detail">
            <h3>Detalle del Lote</h3>
            <div class="muestra-grid">
              <div class="muestra-field">
                <span class="muestra-label">Código de Lote</span>
                <strong>{catalogoItem.codigoLote}</strong>
              </div>
              <div class="muestra-field">
                <span class="muestra-label">Proceso</span>
                <strong>{catalogoItem.proceso}</strong>
              </div>
              <div class="muestra-field">
                <span class="muestra-label">Tipo de Café</span>
                <strong>{catalogoItem.tipoCafe}</strong>
              </div>
              <div class="muestra-field">
                <span class="muestra-label">Peso Disponible</span>
                <strong>{catalogoItem.pesoDisponibleKg} kg</strong>
              </div>
              <div class="muestra-field">
                <span class="muestra-label">Peso Total</span>
                <strong>{catalogoItem.pesoTotalKg} kg</strong>
              </div>
              <div class="muestra-field">
                <span class="muestra-label">Puntaje SCA</span>
                <strong>{catalogoItem.puntajeSca || 'N/A'}</strong>
              </div>
            </div>
          </div>
        )}

        <ProductionChronology estado={estado} />
      </section>

      <aside>
        <PurchasePanel 
          price={price} 
          stock={stock} 
          weight={weight}
          eudrApproved={eudrApproved}
          primas={primas}
          estado={estado}
          productName={title}
          bodegaId={bodegaId}
        />
      </aside>
    </div>
  </main>
</Layout>

<style is:global>
  body {
    font-family: 'Manrope', sans-serif !important;
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.9), rgba(244, 241, 235, 0.96) 40%),
      linear-gradient(180deg, #f7f3ee 0%, #f1eee8 100%) !important;
  }
</style>

<style>
  .detail-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    animation: fadeIn 0.4s ease-out;
  }
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 40px;
    align-items: start;
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .badge-origin {
    display: inline-block;
    background: #e6f4ea;
    color: #137333;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }
  .estado-badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #ffffff;
    background: #6b7280;
  }
  .estado-badge.estado-RECEPCION  { background: #475569; }
  .estado-badge.estado-EN_SECADO  { background: #d97706; }
  .estado-badge.estado-EN_TRILLA  { background: #ea580c; }
  .estado-badge.estado-EN_BODEGA  { background: #16a34a; }
  .estado-badge.estado-TOSTADO    { background: #92400e; }
  .estado-badge.estado-MOLIDO     { background: #9333ea; }
  .estado-badge.estado-DESPACHADO { background: #0d9488; }
  .product-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
    margin-bottom: 8px;
  }
  .muestra-detail {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }
  .muestra-detail h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 16px;
    color: #111827;
  }
  .muestra-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .muestra-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .muestra-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #9ca3af;
    letter-spacing: 0.05em;
  }
  .muestra-field strong {
    font-size: 0.95rem;
    color: #111827;
  }
  .eudr-approved {
    color: #137333 !important;
  }
  .eudr-pending {
    color: #b91c1c !important;
  }

  @media (max-width: 900px) {
    .main-grid {
      grid-template-columns: 1fr;
    }
    .muestra-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>