---
import Layout from '../layouts/Layout.astro';
import PaymentMethods from '../components/checkout/PaymentMethods.astro';
import OrderSummary from '../components/checkout/OrderSummary.astro';
import BreadcrumbRadio from '../components/BreadcrumbRadio.astro';

import { 
  getI18n,
  resolveLocale,
  readConsent 
} from '../lib/i18n';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

const paymentMethods = [
  { id: 'card', name: 'Tarjeta de Crédito', description: 'Visa, MasterCard, American Express', icon: '💳', fee: '2.5%', available: true },
  { id: 'crypto', name: 'Criptomonedas', description: 'Bitcoin, Ethereum', icon: '₿', fee: 'Sin comisión', available: true },
  { id: 'bank', name: 'Transferencia Bancaria', description: 'Transferencia directa a cuenta', icon: '🏦', fee: 'Gratis', available: false },
  { id: 'paypal', name: 'PayPal', description: 'Pago rápido y seguro con PayPal', icon: '🅿️', fee: '3.5%', available: true },
];

// Read product data from query params (passed from PurchasePanel)
const productName = Astro.url.searchParams.get('nombre') || 'Café Origen';
const productPrice = parseFloat(Astro.url.searchParams.get('precio') || '0');
const productVolume = parseFloat(Astro.url.searchParams.get('volumen') || '1');
const productEstado = Astro.url.searchParams.get('estado') || '';
const productEudr = Astro.url.searchParams.get('eudr') === '1';
const productPrimas = parseFloat(Astro.url.searchParams.get('primas') || '0');
const productPeso = parseFloat(Astro.url.searchParams.get('peso') || '0');
const productBodegaId = Astro.url.searchParams.get('bodegaId') || '';

const cartItems = [
  {
    id: '1',
    name: productName,
    quantity: 1,
    price: productPrice > 0 ? productPrice : 25.00,
    estado: productEstado,
    eudrApproved: productEudr,
    primas: productPrimas,
    peso: productPeso > 0 ? productPeso : productVolume,
  },
];
const subtotal = cartItems.reduce((sum, item) => sum + item.price * item.quantity, 0);

// Build the "detail" breadcrumb URL preserving bodegaId for back-navigation
const detailUrl = productBodegaId
  ? `/product-detail?bodegaId=${productBodegaId}`
  : '/product-detail';

const checkoutSteps = [
  { label: m.checkoutSteps.detail, url: detailUrl },
  { label: m.checkoutSteps.pay, url: '/checkout' },
];
---

<Layout 
  locale={locale} 
  title={m.checkout.title}
  description={m.checkout.description}
>
  <main style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
    <BreadcrumbRadio steps={checkoutSteps} currentStep={2} />
    <div style="display: grid; grid-template-columns: 1fr 350px; gap: 40px; align-items: start;">
      <section>
        <PaymentMethods methods={paymentMethods} selectedMethod="card" />
      </section>
      <aside>
        <OrderSummary 
          items={cartItems} 
          subtotal={subtotal}
          taxRate={0.15}
        />
      </aside>
    </div>
  </main>
</Layout>

<script>
  // Save checkout params to sessionStorage so data survives refresh
  // and back-navigation from product-detail.
  const PARAMS_KEY = 'checkout_params';

  (function persistCheckoutParams() {
    const currentParams = window.location.search;

    if (currentParams && currentParams.length > 1) {
      try {
        sessionStorage.setItem(PARAMS_KEY, currentParams);
      } catch (e) {}
    } else {
      try {
        const saved = sessionStorage.getItem(PARAMS_KEY);
        if (saved && saved.length > 1 && !window.location.search) {
          window.location.replace('/checkout' + saved);
        }
      } catch (e) {}
    }
  })();
</script>

<style>
  main {
    animation: fadeIn 0.5s ease-in-out;
  }

  @media (max-width: 768px) {
    main > div {
      grid-template-columns: 1fr;
    }
    aside {
      position: static !important;
      max-height: none !important;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>