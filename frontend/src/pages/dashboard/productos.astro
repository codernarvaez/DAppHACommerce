---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Gestión de Productos">
  <div class="page-header">
    <div>
      <h1>Trazabilidad de Productos</h1>
      <p>Administra y visualiza el historial de producción de café.</p>
    </div>
    <div class="header-actions">
      <button class="btn-primary require-admin-prod" id="btn-agregar">+ Nuevo Producto</button>
      <button class="btn-secondary">📥 Exportar CSV</button>
    </div>
  </div>

  <div class="table-toolbar">
    <div class="search-box">
      <span>🔍</span>
      <input type="text" id="producto-search" placeholder="Buscar por nombre, categoría o estado..." />
    </div>
    <div class="pagination-controls">
      <button title="Refrescar" id="btn-refrescar-productos">🔄</button>
      <select>
        <option>10 filas</option>
        <option>25 filas</option>
      </select>
    </div>
  </div>

  <div class="table-status" id="producto-status">Cargando productos ...</div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Categoría</th>
          <th>Precio Base</th>
          <th>Stock Disponible</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="producto-table-body">
        <tr>
          <td colspan="7">No hay información cargada todavía.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Modal de formulario: Crear / Editar Producto -->
  <div class="modal-overlay" id="producto-form-overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="producto-form-title">
      <div class="modal-header">
        <h2 id="producto-form-title">Nuevo Producto</h2>
        <button type="button" class="modal-close" id="producto-form-close" aria-label="Cerrar">✕</button>
      </div>

      <form id="producto-form" class="modal-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="f-lote_id">ID del lote</label>
            <input type="text" id="f-lote_id" name="lote_id" required />
          </div>
          <div class="form-group">
            <label for="f-nombre">Nombre del producto</label>
            <input type="text" id="f-nombre" name="nombre" required />
          </div>
          <div class="form-group form-group-full">
            <label for="f-descripcion">Descripción</label>
            <textarea id="f-descripcion" name="descripcion" rows="2"></textarea>
          </div>
          <div class="form-group">
            <label for="f-categoria">Categoría</label>
            <input type="text" id="f-categoria" name="categoria" required />
          </div>
          <div class="form-group">
            <label for="f-precio_base">Precio base</label>
            <input type="number" id="f-precio_base" name="precio_base" step="0.01" min="0" required />
          </div>
          <div class="form-group">
            <label for="f-stock_disponible">Stock disponible</label>
            <input type="number" id="f-stock_disponible" name="stock_disponible" step="1" min="0" required />
          </div>
          <div class="form-group">
            <label for="f-estado">Estado</label>
            <select id="f-estado" name="estado" required>
              <option value="borrador">Borrador</option>
              <option value="publicado">Publicado</option>
              <option value="agotado">Agotado</option>
              <option value="inactivo">Inactivo</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-tx_hash">Hash de transacción</label>
            <input type="text" id="f-tx_hash" name="tx_hash" />
          </div>
          <div class="form-group form-group-full">
            <label for="f-imagenes">URLs de imágenes (separadas por coma)</label>
            <textarea id="f-imagenes" name="imagenes" rows="2"></textarea>
          </div>
        </div>
        <p class="form-error" id="producto-form-error" hidden></p>
      </form>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="producto-form-cancel">Cancelar</button>
        <button type="submit" form="producto-form" class="btn-primary">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal genérico de confirmación -->
  <div class="modal-overlay" id="confirm-overlay" hidden>
    <div class="modal modal-sm" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="modal-header">
        <h2 id="confirm-title">Confirmar acción</h2>
        <button type="button" class="modal-close" id="confirm-close" aria-label="Cerrar">✕</button>
      </div>
      <div class="modal-body">
        <p id="confirm-message">¿Estás seguro de realizar esta acción?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="confirm-cancel">Cancelar</button>
        <button type="button" class="btn-primary" id="confirm-accept">Confirmar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-header h1 { font-family: 'Space Grotesk', sans-serif; font-size: 2rem; margin: 0 0 4px; }
  .page-header p { color: #6b7280; margin: 0; }
  
  .header-actions { display: flex; gap: 12px; }
  button { padding: 10px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; border: none; font-size: 0.9rem;}
  .btn-primary { background: #111; color: #fff; transition: 0.2s; }
  .btn-primary:hover { background: #333; }
  .btn-secondary { background: #fff; border: 1px solid #e5e7eb; color: #111; }

  /* Toolbar */
  .table-toolbar { display: flex; justify-content: space-between; margin-bottom: 16px; gap: 16px; }
  .search-box { display: flex; align-items: center; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0 12px; flex: 1; max-width: 400px; }
  .search-box input { border: none; outline: none; padding: 10px; width: 100%; font-family: 'Manrope'; }
  .pagination-controls { display: flex; gap: 12px; }
  .pagination-controls select, .pagination-controls button { padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; cursor: pointer; }
  .table-status { margin-bottom: 12px; color: #4b5563; font-size: 0.95rem; }

  /* Tabla */
  .table-container { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; }
  .data-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
  .data-table th { background: #f9fafb; padding: 16px; font-weight: 700; color: #4b5563; border-bottom: 2px solid #e5e7eb; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
  .data-table td { padding: 16px; border-bottom: 1px solid #e5e7eb; color: #111; vertical-align: middle; }
  .data-table tr:hover { background: #f9fafb; }
  
  .badge { padding: 4px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
  .bg-green { background: #dcfce7; color: #166534; }
  
  .action-cells { display: flex; gap: 8px; }
  .btn-icon { background: none; border: none; padding: 6px; font-size: 1.1rem; border-radius: 6px; }
  .btn-icon:hover { background: #f3f4f6; }
  .text-red { filter: grayscale(1); } /* Solo para mock, puedes usar SVG rojos */

  /* Por defecto ocultamos los botones de permisos estrictos */
  .require-admin-prod { display: none !important; }
  .table-empty { color: #6b7280; text-align: center; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-red { background: #fee2e2; color: #b91c1c; }
  .bg-gray { background: #e5e7eb; color: #374151; }

  /* --- Modales --- */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 1000;
  }
  .modal-overlay[hidden] { display: none; }

  .modal {
    background: #fff;
    border-radius: 12px;
    width: 100%;
    max-width: 640px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }
  .modal-sm { max-width: 420px; }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #e5e7eb;
  }
  .modal-header h2 { margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; }
  .modal-close {
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: #6b7280;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .modal-close:hover { background: #f3f4f6; color: #111; }

  .modal-body { padding: 24px; overflow-y: auto; }
  .modal-body p { margin: 0; color: #374151; line-height: 1.5; }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 24px;
    border-top: 1px solid #e5e7eb;
  }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group-full { grid-column: 1 / -1; }
  .form-group label { font-size: 0.8rem; font-weight: 700; color: #4b5563; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 10px 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: #111; }
  .form-group textarea { resize: vertical; font-family: monospace; }

  .form-error {
    margin-top: 16px;
    padding: 10px 12px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .modal-footer .btn-danger { background: #b91c1c; color: #fff; }
  .modal-footer .btn-danger:hover { background: #991b1b; }

  @media (max-width: 640px) {
    .form-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { createProducto, deleteProducto, fetchProductos, updateProducto } from '../../lib/api/productos';
  import { supabase } from '../../lib/supabase';

  const API_URL = import.meta.env.PUBLIC_API_BASE_URL;

  const productosState = {
    items: [],
    search: '',
  };

  function normalizeRole(role) {
    const value = String(role || '').trim().toLowerCase();
    if (value.includes('admin')) return 'administrador';
    if (value.includes('productor')) return 'productor';
    if (value.includes('empleado') || value.includes('pos') || value.includes('bodega')) return 'empleado';
    if (value.includes('comprador') || value.includes('cliente')) return 'comprador';
    return value;
  }

  function getRole() {
    return normalizeRole(localStorage.getItem('user_role'));
  }

  function canManage() {
    const role = getRole();
    return role === 'administrador' || role === 'productor';
  }

  async function hydrateRoleFromSession() {
    const currentRole = getRole();
    if (currentRole) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.access_token) return;

    try {
      const response = await fetch(`${API_URL}/api/auth/google/sync`, {
        method: 'GET',
        headers: {
          Authorization: `Bearer ${session.access_token}`,
        },
      });

      if (!response.ok) return;
      const data = await response.json();
      const backendRole = normalizeRole(data?.usuario?.rol);
      if (backendRole) {
        localStorage.setItem('user_role', backendRole);
      }
    } catch {
      // Sin bloquear UI si no hay backend o token.
    }
  }

  function setStatus(message) {
    const statusEl = document.getElementById('producto-status');
    if (statusEl) statusEl.textContent = message;
  }

  function formatCurrency(value) {
    return new Intl.NumberFormat('es-EC', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(Number(value || 0));
  }

  function badgeClass(estado) {
    if (estado === 'publicado') return 'badge bg-green';
    if (estado === 'agotado') return 'badge bg-red';
    if (estado === 'inactivo') return 'badge bg-gray';
    return 'badge bg-blue';
  }

  function filteredItems() {
    const term = productosState.search.trim().toLowerCase();
    if (!term) return productosState.items;

    return productosState.items.filter((producto) => {
      return [
        producto.nombre,
        producto.descripcion,
        producto.categoria,
        producto.estado,
        producto.lote_id,
      ].some((value) => String(value || '').toLowerCase().includes(term));
    });
  }

  function syncPermissionButtons() {
    const restrictedElements = document.querySelectorAll('.require-admin-prod');
    const display = canManage() ? 'inline-flex' : 'none';
    restrictedElements.forEach((element) => {
      element.style.setProperty('display', display, 'important');
    });

    /*const addButton = document.getElementById('btn-agregar');
    if (addButton) addButton.style.display = canManage() ? 'inline-flex' : 'none';*/
  }

  function renderTable() {
    const tbody = document.getElementById('producto-table-body');
    if (!tbody) return;

    const productos = filteredItems();
    tbody.innerHTML = '';

    if (!productos.length) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 7;
      cell.className = 'table-empty';
      cell.textContent = productosState.items.length ? 'No hay productos que coincidan con el filtro.' : 'No existen productos registrados.';
      row.appendChild(cell);
      tbody.appendChild(row);
      return;
    }

    for (const producto of productos) {
      const row = document.createElement('tr');
      row.innerHTML = `
        <td><strong>${producto.nombre}</strong></td>
        <td>${producto.descripcion || '-'}</td>
        <td>${producto.categoria}</td>
        <td>$ ${formatCurrency(producto.precio_base)}</td>
        <td>${producto.stock_disponible}</td>
        <td><span class="${badgeClass(producto.estado)}">${producto.estado}</span></td>
        <td class="action-cells">
          <button class="btn-icon" data-action="view" data-id="${producto.id}" title="Ver Detalles">👁️</button>
          <button class="btn-icon require-admin-prod" data-action="edit" data-id="${producto.id}" title="Editar">✏️</button>
          <button class="btn-icon require-admin-prod text-red" data-action="delete" data-id="${producto.id}" title="Eliminar">🗑️</button>
        </td>
      `;
      tbody.appendChild(row);
    }

    syncPermissionButtons();
  }

  function parseImagenes(value) {
    return String(value || '')
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean);
  }

  /* ---------- Modal de confirmación genérico ---------- */

  const confirmOverlay = document.getElementById('confirm-overlay');
  const confirmTitle = document.getElementById('confirm-title');
  const confirmMessage = document.getElementById('confirm-message');
  const confirmAcceptBtn = document.getElementById('confirm-accept');
  const confirmCancelBtn = document.getElementById('confirm-cancel');
  const confirmCloseBtn = document.getElementById('confirm-close');

  let pendingConfirmAction = null;

  function openConfirmModal({ title, message, confirmLabel = 'Confirmar', danger = false, onConfirm }) {
    confirmTitle.textContent = title;
    confirmMessage.textContent = message;
    confirmAcceptBtn.textContent = confirmLabel;
    confirmAcceptBtn.classList.toggle('btn-danger', danger);
    pendingConfirmAction = onConfirm;
    confirmOverlay.hidden = false;
  }

  function closeConfirmModal() {
    confirmOverlay.hidden = true;
    pendingConfirmAction = null;
  }

  confirmAcceptBtn?.addEventListener('click', async () => {
    const action = pendingConfirmAction;
    closeConfirmModal();
    if (action) await action();
  });
  confirmCancelBtn?.addEventListener('click', closeConfirmModal);
  confirmCloseBtn?.addEventListener('click', closeConfirmModal);
  confirmOverlay?.addEventListener('click', (event) => {
    if (event.target === confirmOverlay) closeConfirmModal();
  });

  /* ---------- Modal de formulario (crear / editar) ---------- */

  const productoFormOverlay = document.getElementById('producto-form-overlay');
  const productoForm = document.getElementById('producto-form');
  const productoFormTitle = document.getElementById('producto-form-title');
  const productoFormError = document.getElementById('producto-form-error');
  const productoFormCancelBtn = document.getElementById('producto-form-cancel');
  const productoFormCloseBtn = document.getElementById('producto-form-close');

  let formMode = 'create'; // 'create' | 'edit'
  let editingId = null;

  function showFormError(message) {
    productoFormError.textContent = message;
    productoFormError.hidden = false;
  }

  function clearFormError() {
    productoFormError.hidden = true;
    productoFormError.textContent = '';
  }

  function fillForm(existing) {
    productoForm.elements['lote_id'].value = existing?.lote_id ?? '';
    productoForm.elements['nombre'].value = existing?.nombre ?? '';
    productoForm.elements['descripcion'].value = existing?.descripcion ?? '';
    productoForm.elements['categoria'].value = existing?.categoria ?? '';
    productoForm.elements['precio_base'].value = existing?.precio_base ?? '';
    productoForm.elements['stock_disponible'].value = existing?.stock_disponible ?? '';
    productoForm.elements['estado'].value = existing?.estado ?? 'borrador';
    productoForm.elements['tx_hash'].value = existing?.tx_hash ?? '';
    productoForm.elements['imagenes'].value = (existing?.imagenes ?? []).join(', ');
  }

  function openProductoFormModal(mode, existing) {
    formMode = mode;
    editingId = existing?.id ?? null;
    productoFormTitle.textContent = mode === 'edit' ? `Editar Producto ${existing?.nombre ?? ''}` : 'Nuevo Producto';
    clearFormError();
    fillForm(existing);
    productoFormOverlay.hidden = false;
  }

  function closeProductoFormModal() {
    productoFormOverlay.hidden = true;
    productoForm.reset();
    clearFormError();
    editingId = null;
  }

  productoFormCancelBtn?.addEventListener('click', closeProductoFormModal);
  productoFormCloseBtn?.addEventListener('click', closeProductoFormModal);
  productoFormOverlay?.addEventListener('click', (event) => {
    if (event.target === productoFormOverlay) closeProductoFormModal();
  });

  function readFormPayload() {
    const formData = new FormData(productoForm);
    const raw = Object.fromEntries(formData.entries());

    if (!raw.lote_id || !raw.nombre || !raw.categoria || !raw.precio_base || !raw.stock_disponible || !raw.estado) {
      throw new Error('Completa todos los campos obligatorios.');
    }

    return {
      lote_id: raw.lote_id,
      nombre: raw.nombre,
      descripcion: raw.descripcion || '',
      categoria: raw.categoria,
      imagenes: parseImagenes(raw.imagenes),
      precio_base: Number(raw.precio_base),
      stock_disponible: Number(raw.stock_disponible),
      estado: raw.estado,
      tx_hash: raw.tx_hash || null,
    };
  }

  productoForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!canManage()) return;

    clearFormError();

    let payload;
    try {
      payload = readFormPayload();
    } catch (error) {
      showFormError(error instanceof Error ? error.message : 'Datos inválidos.');
      return;
    }

    const isEdit = formMode === 'edit';
    const id = editingId;

    openConfirmModal({
      title: isEdit ? 'Confirmar edición' : 'Confirmar creación',
      message: isEdit
        ? `¿Deseas guardar los cambios del producto ${payload.nombre}?`
        : `¿Deseas registrar el producto ${payload.nombre}?`,
      confirmLabel: isEdit ? 'Guardar cambios' : 'Crear producto',
      onConfirm: async () => {
        try {
          if (isEdit && id) {
            await updateProducto(id, payload);
          } else {
            await createProducto(payload);
          }
          closeProductoFormModal();
          await loadProductos();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'No fue posible guardar el producto.';
          openProductoFormModal(formMode, isEdit ? { ...payload, id } : payload);
          showFormError(message);
        }
      },
    });
  });

  async function loadProductos() {
    setStatus('Cargando productos ...');
    try {
      productosState.items = await fetchProductos();
      renderTable();
      setStatus(`Se cargaron ${productosState.items.length} productos.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No fue posible cargar los productos.';
      setStatus(message);
      renderTable();
    }
  }

  function handleCreate() {
    if (!canManage()) return;
    openProductoFormModal('create', null);
  }

  function handleEdit(id) {
    if (!canManage()) return;

    const existing = productosState.items.find((item) => item.id === id);
    if (!existing) return;

    openProductoFormModal('edit', existing);
  }

  function handleDelete(id) {
    if (!canManage()) return;

    const existing = productosState.items.find((item) => item.id === id);
    if (!existing) return;

    openConfirmModal({
      title: 'Eliminar producto',
      message: `¿Estás seguro de eliminar el producto ${existing.nombre}? Esta acción no se puede deshacer.`,
      confirmLabel: 'Eliminar',
      danger: true,
      onConfirm: async () => {
        try {
          await deleteProducto(id);
          await loadProductos();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'No fue posible eliminar el producto.';
          window.alert(message);
        }
      },
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    await hydrateRoleFromSession();
    syncPermissionButtons();

    document.getElementById('btn-agregar')?.addEventListener('click', handleCreate);
    document.getElementById('btn-refrescar-productos')?.addEventListener('click', loadProductos);
    document.getElementById('producto-search')?.addEventListener('input', (event) => {
      const input = event.target;
      if (input instanceof HTMLInputElement) {
        productosState.search = input.value;
        renderTable();
      }
    });

    document.getElementById('producto-table-body')?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const action = target.dataset.action;
      const id = target.dataset.id;
      if (!action || !id) return;

      if (action === 'view') {
        const producto = productosState.items.find((item) => item.id === id);
        if (producto) window.alert(JSON.stringify(producto, null, 2));
        return;
      }

      if (action === 'edit') {
        void handleEdit(id);
        return;
      }

      if (action === 'delete') {
        void handleDelete(id);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!confirmOverlay.hidden) closeConfirmModal();
      else if (!productoFormOverlay.hidden) closeProductoFormModal();
    });

    await loadProductos();
  });
</script>