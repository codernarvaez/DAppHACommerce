---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Gestión de Lotes">
  <div class="page-header">
    <div>
      <h1>Trazabilidad de Lotes</h1>
      <p>Administra y visualiza el historial de producción de café.</p>
    </div>
    <div class="header-actions">
      <button class="btn-primary require-admin-prod" id="btn-agregar">+ Nuevo Lote</button>
      <button class="btn-secondary">📥 Exportar CSV</button>
    </div>
  </div>

  <div class="table-toolbar">
    <div class="search-box">
      <span>🔍</span>
      <input type="text" id="lote-search" placeholder="Buscar por código, variedad u origen..." />
    </div>
    <div class="pagination-controls">
      <button title="Refrescar" id="btn-refrescar-lotes">🔄</button>
      <select>
        <option>10 filas</option>
        <option>25 filas</option>
      </select>
    </div>
  </div>

  <div class="table-status" id="lote-status">Cargando lotes desde la base de datos...</div>

  <div class="table-container">
    <table class="data-table">
      <thead>
        <tr>
          <th>Código</th>
          <th>Variedad</th>
          <th>Origen</th>
          <th>Cosecha</th>
          <th>Peso (Kg)</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="lote-table-body">
        <tr>
          <td colspan="7">No hay información cargada todavía.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Modal de formulario: Crear / Editar Lote -->
  <div class="modal-overlay" id="lote-form-overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="lote-form-title">
      <div class="modal-header">
        <h2 id="lote-form-title">Nuevo Lote</h2>
        <button type="button" class="modal-close" id="lote-form-close" aria-label="Cerrar">✕</button>
      </div>

      <form id="lote-form" class="modal-body">
        <div class="form-grid">
          <div class="form-group">
            <label for="f-productor_id">ID del productor</label>
            <input type="text" id="f-productor_id" name="productor_id" required />
          </div>
          <div class="form-group">
            <label for="f-codigo_lote">Código del lote</label>
            <input type="text" id="f-codigo_lote" name="codigo_lote" required />
          </div>
          <div class="form-group">
            <label for="f-variedad">Variedad</label>
            <input type="text" id="f-variedad" name="variedad" required />
          </div>
          <div class="form-group">
            <label for="f-fecha_cosecha">Fecha de cosecha</label>
            <input type="date" id="f-fecha_cosecha" name="fecha_cosecha" required />
          </div>
          <div class="form-group">
            <label for="f-peso_kg">Peso (Kg)</label>
            <input type="number" id="f-peso_kg" name="peso_kg" step="0.01" min="0" required />
          </div>
          <div class="form-group">
            <label for="f-proceso">Proceso</label>
            <input type="text" id="f-proceso" name="proceso" required />
          </div>
          <div class="form-group">
            <label for="f-origen_geo">Origen geográfico</label>
            <input type="text" id="f-origen_geo" name="origen_geo" required />
          </div>
          <div class="form-group">
            <label for="f-estado">Estado</label>
            <select id="f-estado" name="estado" required>
              <option value="registrado">Registrado</option>
              <option value="verificado">Verificado</option>
              <option value="publicado">Publicado</option>
            </select>
          </div>
          <div class="form-group">
            <label for="f-id_trazabilidad_externa">ID trazabilidad externa</label>
            <input type="text" id="f-id_trazabilidad_externa" name="id_trazabilidad_externa" />
          </div>
          <div class="form-group">
            <label for="f-tx_hash">Hash de transacción</label>
            <input type="text" id="f-tx_hash" name="tx_hash" />
          </div>
          <div class="form-group form-group-full">
            <label for="f-datos_trazabilidad">Datos de trazabilidad (JSON)</label>
            <textarea id="f-datos_trazabilidad" name="datos_trazabilidad" rows="4">{}</textarea>
          </div>
        </div>
        <p class="form-error" id="lote-form-error" hidden></p>
      </form>

      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="lote-form-cancel">Cancelar</button>
        <button type="submit" form="lote-form" class="btn-primary">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal genérico de confirmación -->
  <div class="modal-overlay" id="confirm-overlay" hidden>
    <div class="modal modal-sm" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
      <div class="modal-header">
        <h2 id="confirm-title">Confirmar acción</h2>
        <button type="button" class="modal-close" id="confirm-close" aria-label="Cerrar">✕</button>
      </div>
      <div class="modal-body">
        <p id="confirm-message">¿Estás seguro de realizar esta acción?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="confirm-cancel">Cancelar</button>
        <button type="button" class="btn-primary" id="confirm-accept">Confirmar</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .page-header h1 { font-family: 'Space Grotesk', sans-serif; font-size: 2rem; margin: 0 0 4px; }
  .page-header p { color: #6b7280; margin: 0; }
  
  .header-actions { display: flex; gap: 12px; }
  button { padding: 10px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; border: none; font-size: 0.9rem;}
  .btn-primary { background: #111; color: #fff; transition: 0.2s; }
  .btn-primary:hover { background: #333; }
  .btn-secondary { background: #fff; border: 1px solid #e5e7eb; color: #111; }

  /* Toolbar */
  .table-toolbar { display: flex; justify-content: space-between; margin-bottom: 16px; gap: 16px; }
  .search-box { display: flex; align-items: center; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0 12px; flex: 1; max-width: 400px; }
  .search-box input { border: none; outline: none; padding: 10px; width: 100%; font-family: 'Manrope'; }
  .pagination-controls { display: flex; gap: 12px; }
  .pagination-controls select, .pagination-controls button { padding: 8px 12px; border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; cursor: pointer; }
  .table-status { margin-bottom: 12px; color: #4b5563; font-size: 0.95rem; }

  /* Tabla */
  .table-container { background: #fff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; }
  .data-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
  .data-table th { background: #f9fafb; padding: 16px; font-weight: 700; color: #4b5563; border-bottom: 2px solid #e5e7eb; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
  .data-table td { padding: 16px; border-bottom: 1px solid #e5e7eb; color: #111; vertical-align: middle; }
  .data-table tr:hover { background: #f9fafb; }
  
  .badge { padding: 4px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
  .bg-green { background: #dcfce7; color: #166534; }
  .bg-blue { background: #dbeafe; color: #1d4ed8; }
  .bg-gray { background: #e5e7eb; color: #374151; }
  
  .action-cells { display: flex; gap: 8px; }
  .btn-icon { background: none; border: none; padding: 6px; font-size: 1.1rem; border-radius: 6px; }
  .btn-icon:hover { background: #f3f4f6; }
  .text-red { filter: grayscale(1); } /* Solo para mock, puedes usar SVG rojos */

  /* Por defecto ocultamos los botones de permisos estrictos */
  .require-admin-prod { display: none !important; }
  .table-empty { color: #6b7280; text-align: center; }

  /* --- Modales --- */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 1000;
  }
  .modal-overlay[hidden] { display: none; }

  .modal {
    background: #fff;
    border-radius: 12px;
    width: 100%;
    max-width: 640px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }
  .modal-sm { max-width: 420px; }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #e5e7eb;
  }
  .modal-header h2 { margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; }
  .modal-close {
    background: none;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    color: #6b7280;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .modal-close:hover { background: #f3f4f6; color: #111; }

  .modal-body { padding: 24px; overflow-y: auto; }
  .modal-body p { margin: 0; color: #374151; line-height: 1.5; }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 24px;
    border-top: 1px solid #e5e7eb;
  }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group-full { grid-column: 1 / -1; }
  .form-group label { font-size: 0.8rem; font-weight: 700; color: #4b5563; }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 10px 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-family: 'Manrope', sans-serif;
    font-size: 0.9rem;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus { border-color: #111; }
  .form-group textarea { resize: vertical; font-family: monospace; }

  .form-error {
    margin-top: 16px;
    padding: 10px 12px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .modal-footer .btn-danger { background: #b91c1c; color: #fff; }
  .modal-footer .btn-danger:hover { background: #991b1b; }

  @media (max-width: 640px) {
    .form-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { createLote, deleteLote, fetchLotes, updateLote } from '../../lib/api/lotes';
  import { supabase } from '../../lib/supabase';

  const API_URL = import.meta.env.PUBLIC_API_BASE_URL;

  const lotesState = {
    items: [],
    search: '',
  };

  function normalizeRole(role) {
    const value = String(role || '').trim().toLowerCase();
    if (value.includes('admin')) return 'administrador';
    if (value.includes('productor')) return 'productor';
    if (value.includes('empleado') || value.includes('pos') || value.includes('bodega')) return 'empleado';
    if (value.includes('comprador') || value.includes('cliente')) return 'comprador';
    return value;
  }

  function getRole() {
    return normalizeRole(localStorage.getItem('user_role'));
  }

  function canManage() {
    const role = getRole();
    return role === 'administrador' || role === 'productor';
  }

  async function hydrateRoleFromSession() {
    const currentRole = getRole();
    if (currentRole) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.access_token) return;

    try {
      const response = await fetch(`${API_URL}/api/auth/google/sync`, {
        method: 'GET',
        headers: {
          Authorization: `Bearer ${session.access_token}`,
        },
      });

      if (!response.ok) return;
      const data = await response.json();
      const backendRole = normalizeRole(data?.usuario?.rol);
      if (backendRole) {
        localStorage.setItem('user_role', backendRole);
      }
    } catch {
      // Sin bloquear UI si no hay backend o token.
    }
  }

  function setStatus(message) {
    const statusEl = document.getElementById('lote-status');
    if (statusEl) statusEl.textContent = message;
  }

  function formatCurrency(value) {
    return new Intl.NumberFormat('es-EC', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(Number(value || 0));
  }

  function badgeClass(estado) {
    if (estado === 'publicado') return 'badge bg-green';
    if (estado === 'verificado') return 'badge bg-blue';
    return 'badge bg-gray';
  }

  function filteredItems() {
    const term = lotesState.search.trim().toLowerCase();
    if (!term) return lotesState.items;

    return lotesState.items.filter((lote) => {
      return [
        lote.codigo_lote,
        lote.variedad,
        lote.origen_geo,
        lote.estado,
        lote.proceso,
      ].some((value) => String(value || '').toLowerCase().includes(term));
    });
  }

  function renderTable() {
    const tbody = document.getElementById('lote-table-body');
    if (!tbody) return;

    const lotes = filteredItems();
    tbody.innerHTML = '';

    if (!lotes.length) {
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 7;
      cell.className = 'table-empty';
      cell.textContent = lotesState.items.length ? 'No hay lotes que coincidan con el filtro.' : 'No existen lotes registrados.';
      row.appendChild(cell);
      tbody.appendChild(row);
      return;
    }

    for (const lote of lotes) {
      const row = document.createElement('tr');

      row.innerHTML = `
        <td><strong>${lote.codigo_lote}</strong></td>
        <td>${lote.variedad}</td>
        <td>${lote.origen_geo}</td>
        <td>${String(lote.fecha_cosecha).slice(0, 10)}</td>
        <td>${formatCurrency(lote.peso_kg)}</td>
        <td><span class="${badgeClass(lote.estado)}">${lote.estado}</span></td>
        <td class="action-cells">
          <button class="btn-icon" data-action="view" data-id="${lote.id}" title="Ver Detalles">👁️</button>
          <button class="btn-icon require-admin-prod" data-action="edit" data-id="${lote.id}" title="Editar">✏️</button>
          <button class="btn-icon require-admin-prod text-red" data-action="delete" data-id="${lote.id}" title="Eliminar">🗑️</button>
        </td>
      `;

      tbody.appendChild(row);
    }

    syncPermissionButtons();
  }

  function syncPermissionButtons() {
    const restrictedElements = document.querySelectorAll('.require-admin-prod');
    const display = canManage() ? 'inline-flex' : 'none';
    restrictedElements.forEach((element) => {
      element.style.setProperty('display', display, 'important');
    });

    /*const addButton = document.getElementById('btn-agregar');
    if (addButton) {
      addButton.style.display = canManage() ? 'inline-flex' : 'none';
    }*/
  }

  function parseOptionalJson(value) {
    if (!value || !value.trim()) return {};
    return JSON.parse(value);
  }

  /* ---------- Modal de confirmación genérico ---------- */

  const confirmOverlay = document.getElementById('confirm-overlay');
  const confirmTitle = document.getElementById('confirm-title');
  const confirmMessage = document.getElementById('confirm-message');
  const confirmAcceptBtn = document.getElementById('confirm-accept');
  const confirmCancelBtn = document.getElementById('confirm-cancel');
  const confirmCloseBtn = document.getElementById('confirm-close');

  let pendingConfirmAction = null;

  function openConfirmModal({ title, message, confirmLabel = 'Confirmar', danger = false, onConfirm }) {
    confirmTitle.textContent = title;
    confirmMessage.textContent = message;
    confirmAcceptBtn.textContent = confirmLabel;
    confirmAcceptBtn.classList.toggle('btn-danger', danger);
    pendingConfirmAction = onConfirm;
    confirmOverlay.hidden = false;
  }

  function closeConfirmModal() {
    confirmOverlay.hidden = true;
    pendingConfirmAction = null;
  }

  confirmAcceptBtn?.addEventListener('click', async () => {
    const action = pendingConfirmAction;
    closeConfirmModal();
    if (action) await action();
  });
  confirmCancelBtn?.addEventListener('click', closeConfirmModal);
  confirmCloseBtn?.addEventListener('click', closeConfirmModal);
  confirmOverlay?.addEventListener('click', (event) => {
    if (event.target === confirmOverlay) closeConfirmModal();
  });

  /* ---------- Modal de formulario (crear / editar) ---------- */

  const loteFormOverlay = document.getElementById('lote-form-overlay');
  const loteForm = document.getElementById('lote-form');
  const loteFormTitle = document.getElementById('lote-form-title');
  const loteFormError = document.getElementById('lote-form-error');
  const loteFormCancelBtn = document.getElementById('lote-form-cancel');
  const loteFormCloseBtn = document.getElementById('lote-form-close');

  let formMode = 'create'; // 'create' | 'edit'
  let editingId = null;

  function showFormError(message) {
    loteFormError.textContent = message;
    loteFormError.hidden = false;
  }

  function clearFormError() {
    loteFormError.hidden = true;
    loteFormError.textContent = '';
  }

  function fillForm(existing) {
    loteForm.elements['productor_id'].value = existing?.productor_id ?? '';
    loteForm.elements['codigo_lote'].value = existing?.codigo_lote ?? '';
    loteForm.elements['variedad'].value = existing?.variedad ?? '';
    loteForm.elements['fecha_cosecha'].value = existing?.fecha_cosecha ? String(existing.fecha_cosecha).slice(0, 10) : '';
    loteForm.elements['peso_kg'].value = existing?.peso_kg ?? '';
    loteForm.elements['proceso'].value = existing?.proceso ?? '';
    loteForm.elements['origen_geo'].value = existing?.origen_geo ?? '';
    loteForm.elements['estado'].value = existing?.estado ?? 'registrado';
    loteForm.elements['id_trazabilidad_externa'].value = existing?.id_trazabilidad_externa ?? '';
    loteForm.elements['tx_hash'].value = existing?.tx_hash ?? '';
    loteForm.elements['datos_trazabilidad'].value = JSON.stringify(existing?.datos_trazabilidad ?? {}, null, 2);
  }

  function openLoteFormModal(mode, existing) {
    formMode = mode;
    editingId = existing?.id ?? null;
    loteFormTitle.textContent = mode === 'edit' ? `Editar Lote ${existing?.codigo_lote ?? ''}` : 'Nuevo Lote';
    clearFormError();
    fillForm(existing);
    loteFormOverlay.hidden = false;
  }

  function closeLoteFormModal() {
    loteFormOverlay.hidden = true;
    loteForm.reset();
    clearFormError();
    editingId = null;
  }

  loteFormCancelBtn?.addEventListener('click', closeLoteFormModal);
  loteFormCloseBtn?.addEventListener('click', closeLoteFormModal);
  loteFormOverlay?.addEventListener('click', (event) => {
    if (event.target === loteFormOverlay) closeLoteFormModal();
  });

  function readFormPayload() {
    const formData = new FormData(loteForm);
    const raw = Object.fromEntries(formData.entries());

    if (!raw.productor_id || !raw.codigo_lote || !raw.variedad || !raw.fecha_cosecha || !raw.peso_kg || !raw.proceso || !raw.origen_geo || !raw.estado) {
      throw new Error('Completa todos los campos obligatorios.');
    }

    let parsedJson;
    try {
      parsedJson = parseOptionalJson(raw.datos_trazabilidad);
    } catch {
      throw new Error('El campo de datos de trazabilidad debe ser JSON válido.');
    }

    return {
      productor_id: raw.productor_id,
      codigo_lote: raw.codigo_lote,
      variedad: raw.variedad,
      fecha_cosecha: raw.fecha_cosecha,
      peso_kg: Number(raw.peso_kg),
      proceso: raw.proceso,
      origen_geo: raw.origen_geo,
      estado: raw.estado,
      id_trazabilidad_externa: raw.id_trazabilidad_externa || '',
      datos_trazabilidad: parsedJson,
      tx_hash: raw.tx_hash || null,
    };
  }

  loteForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!canManage()) return;

    clearFormError();

    let payload;
    try {
      payload = readFormPayload();
    } catch (error) {
      showFormError(error instanceof Error ? error.message : 'Datos inválidos.');
      return;
    }

    const isEdit = formMode === 'edit';
    const id = editingId;

    openConfirmModal({
      title: isEdit ? 'Confirmar edición' : 'Confirmar creación',
      message: isEdit
        ? `¿Deseas guardar los cambios del lote ${payload.codigo_lote}?`
        : `¿Deseas registrar el lote ${payload.codigo_lote}?`,
      confirmLabel: isEdit ? 'Guardar cambios' : 'Crear lote',
      onConfirm: async () => {
        try {
          if (isEdit && id) {
            await updateLote(id, payload);
          } else {
            await createLote(payload);
          }
          closeLoteFormModal();
          await loadLotes();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'No fue posible guardar el lote.';
          openLoteFormModal(formMode, isEdit ? { ...payload, id } : payload);
          showFormError(message);
        }
      },
    });
  });

  async function loadLotes() {
    setStatus('Cargando lotes desde la base de datos...');
    try {
      lotesState.items = await fetchLotes();
      renderTable();
      setStatus(`Se cargaron ${lotesState.items.length} lotes desde la base de datos.`);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No fue posible cargar los lotes.';
      setStatus(message);
      renderTable();
    }
  }

  function handleCreate() {
    if (!canManage()) return;
    openLoteFormModal('create', null);
  }

  function handleEdit(id) {
    if (!canManage()) return;

    const existing = lotesState.items.find((item) => item.id === id);
    if (!existing) return;

    openLoteFormModal('edit', existing);
  }

  function handleDelete(id) {
    if (!canManage()) return;

    const existing = lotesState.items.find((item) => item.id === id);
    if (!existing) return;

    openConfirmModal({
      title: 'Eliminar lote',
      message: `¿Estás seguro de eliminar el lote ${existing.codigo_lote}? Esta acción no se puede deshacer.`,
      confirmLabel: 'Eliminar',
      danger: true,
      onConfirm: async () => {
        try {
          await deleteLote(id);
          await loadLotes();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'No fue posible eliminar el lote.';
          window.alert(message);
        }
      },
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    await hydrateRoleFromSession();
    syncPermissionButtons();

    document.getElementById('btn-agregar')?.addEventListener('click', handleCreate);
    document.getElementById('btn-refrescar-lotes')?.addEventListener('click', loadLotes);
    document.getElementById('lote-search')?.addEventListener('input', (event) => {
      const input = event.target;
      if (input instanceof HTMLInputElement) {
        lotesState.search = input.value;
        renderTable();
      }
    });

    document.getElementById('lote-table-body')?.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const action = target.dataset.action;
      const id = target.dataset.id;
      if (!action || !id) return;

      if (action === 'view') {
        const lote = lotesState.items.find((item) => item.id === id);
        if (lote) window.alert(JSON.stringify(lote, null, 2));
        return;
      }

      if (action === 'edit') {
        void handleEdit(id);
        return;
      }

      if (action === 'delete') {
        void handleDelete(id);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (!confirmOverlay.hidden) closeConfirmModal();
      else if (!loteFormOverlay.hidden) closeLoteFormModal();
    });

    await loadLotes();
  });
</script>