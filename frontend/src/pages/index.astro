---
import Layout from '../layouts/Layout.astro';

const products = [
	{
		origin: 'ETIOPIA · YIRGACHEFFE',
		title: 'Gedeo Zone Lot #402',
		score: '92',
		price: '$18.50/lb',
		label: 'AUCTION',
		description: 'Jasmine, bergamot, and citrus notes with a clean floral finish.',
		accent: 'from-ruby-500 via-amber-500 to-lime-400',
	},
	{
		origin: 'ECUADOR · ARRIBA NACIONAL',
		title: 'Los Rios Heirloom',
		score: '88',
		price: '$9.20/lb',
		label: 'DIRECT BUY',
		description: 'Deep floral aroma with intense nuttiness and a silky body.',
		accent: 'from-slate-700 via-stone-500 to-amber-300',
	},
	{
		origin: 'COLOMBIA · HUILA',
		title: 'Pink Bourbon Micro-lot',
		score: '90',
		price: '$14.00/lb',
		label: 'DIRECT BUY',
		description: 'Sweet stone fruit notes with a silky body and washed clarity.',
		accent: 'from-amber-900 via-stone-700 to-zinc-300',
	},
	{
		origin: 'MADAGASCAR · SAMBIRANO',
		title: 'Organic Fine Flavor',
		score: '86',
		price: '$7.50/lb',
		label: 'AUCTION',
		description: 'Bright fruity acidity with raspberry and cherry sweetness.',
		accent: 'from-emerald-950 via-slate-700 to-orange-400',
	},
];

const filters = ['Type: All', 'Origin', 'Score: 85+', 'Process'];
---

<Layout>
	<main class="page-shell">
		<header class="topbar">
			<div class="brand">
				<span class="menu">☰</span>
				<span>ORIGIN TECH</span>
			</div>
			<nav>
				<a href="#market">Market</a>
				<a href="#auctions">Auctions</a>
				<a href="#wallet">Wallet</a>
				<a href="#profile">Profile</a>
			</nav>
			<div class="icon-badge">⌂</div>
		</header>

		<section class="hero">
			<div class="hero-copy">
				<p class="eyebrow">PREMIUM HARVEST 2024</p>
				<h1>Specialty Trade Ecosystem</h1>
				<p class="lede">
					Direct-to-origin marketplace for traceable coffee and cacao lots with clean verification,
					live auctions, and professional sourcing.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#market">Browse Inventory</a>
					<a class="button button-secondary" href="#auctions">Live Auctions</a>
				</div>
			</div>
			<div class="hero-visual" aria-hidden="true">
				<div class="grain grain-one"></div>
				<div class="grain grain-two"></div>
				<div class="device device-one"></div>
				<div class="device device-two"></div>
				<div class="cup"></div>
			</div>
		</section>

		<section class="filters" aria-label="Filters">
			<button class="filters-toggle">Filters</button>
			<div class="chips">
				{filters.map((filter) => <span class="chip">{filter}</span>)}
			</div>
			<div class="view-icons" aria-hidden="true">
				<span>▦</span>
				<span>☰</span>
			</div>
		</section>

		<section class="market" id="market">
			{products.map((product) => (
				<article class="card">
					<div class={`card-art ${product.accent}`}>
						<span class="card-label">{product.label}</span>
						<div class="art-shadow"></div>
					</div>
					<div class="card-body">
						<div class="meta-row">
							<p class="origin">{product.origin}</p>
							<span class="score">{product.score}</span>
						</div>
						<h2>{product.title}</h2>
						<p class="description">{product.description}</p>
						<div class="price-row">
							<div>
								<span class="price-label">Current bid</span>
								<strong>{product.price}</strong>
							</div>
							<button class="mini-button" type="button">↗</button>
						</div>
					</div>
				</article>
			))}
		</section>

		<section class="integrity" id="auctions">
			<div class="integrity-copy">
				<p class="eyebrow dark">Verifiable Integrity.</p>
				<p>
					Every lot is validated with sensory evaluation and traceability checks. The result is a clean
					marketplace where farmers and buyers can trade with confidence.
				</p>
			</div>
			<div class="stats">
				<div class="stat">
					<span>Network Volume</span>
					<strong>$142M+</strong>
				</div>
				<div class="stat">
					<span>Verified Producers</span>
					<strong>12,400</strong>
				</div>
			</div>
		</section>

		<footer class="footer">
			<div>
				<h3>ORIGIN TECH</h3>
				<p>The digital infrastructure for the next generation of specialty agricultural trade.</p>
			</div>
			<div>
				<h4>Platform</h4>
				<a href="#market">Marketplace</a>
				<a href="#auctions">Traceability Hub</a>
				<a href="#profile">Sustainability</a>
			</div>
			<div>
				<h4>Resources</h4>
				<a href="#">Documentation</a>
				<a href="#">API Reference</a>
				<a href="#">Privacy Policy</a>
			</div>
		</footer>
	</main>

	<style>
		@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap');

		:global(html) {
			scroll-behavior: smooth;
			background: #f4f1eb;
		}

		:global(body) {
			font-family: 'Manrope', sans-serif;
			background:
				radial-gradient(circle at top, rgba(255, 255, 255, 0.9), rgba(244, 241, 235, 0.96) 40%),
				linear-gradient(180deg, #f7f3ee 0%, #f1eee8 100%);
			color: #121212;
		}

		.page-shell {
			width: min(1280px, calc(100% - 32px));
			margin: 0 auto;
			padding: 16px 0 56px;
		}

		.topbar,
		.filters,
		.market,
		.integrity,
		.footer {
			border-radius: 24px;
		}

		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 18px 22px;
			background: rgba(255, 255, 255, 0.72);
			backdrop-filter: blur(18px);
			border: 1px solid rgba(18, 18, 18, 0.08);
			box-shadow: 0 14px 35px rgba(18, 18, 18, 0.08);
		}

		.brand,
		nav,
		.hero-actions,
		.chips,
		.meta-row,
		.price-row,
		.filters,
		.footer {
			display: flex;
		}

		.brand {
			align-items: center;
			gap: 12px;
			font-weight: 800;
			letter-spacing: 0.08em;
			font-size: 0.85rem;
		}

		.menu,
		.icon-badge,
		.mini-button,
		.filters-toggle {
			display: grid;
			place-items: center;
		}

		.menu,
		.icon-badge {
			width: 34px;
			height: 34px;
			border-radius: 999px;
			background: #111;
			color: white;
			font-size: 0.9rem;
		}

		nav {
			gap: 28px;
			font-size: 0.92rem;
		}

		nav a,
		.footer a {
			color: inherit;
			text-decoration: none;
			opacity: 0.82;
		}

		nav a:hover,
		.footer a:hover {
			opacity: 1;
		}

		.hero {
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			gap: 26px;
			margin-top: 18px;
		}

		.hero-copy,
		.hero-visual {
			min-height: 500px;
			border-radius: 30px;
			overflow: hidden;
		}

		.hero-copy {
			padding: 42px;
			background: linear-gradient(160deg, rgba(15, 15, 15, 0.97), rgba(25, 25, 25, 0.88));
			color: #f7f3ee;
			display: flex;
			flex-direction: column;
			justify-content: center;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
		}

		.eyebrow {
			display: inline-flex;
			width: fit-content;
			padding: 6px 10px;
			border-radius: 999px;
			font-size: 0.74rem;
			font-weight: 800;
			letter-spacing: 0.12em;
			background: rgba(28, 165, 132, 0.2);
			color: #58d0b5;
			margin-bottom: 22px;
		}

		.eyebrow.dark {
			background: rgba(16, 185, 129, 0.12);
			color: #19b88b;
			margin-bottom: 16px;
		}

		h1 {
			font-family: 'Space Grotesk', sans-serif;
			font-size: clamp(3.2rem, 6vw, 5.8rem);
			line-height: 0.95;
			letter-spacing: -0.05em;
			margin: 0;
			max-width: 10ch;
		}

		.lede,
		.integrity-copy p,
		.card-body .description,
		.footer p {
			color: rgba(247, 243, 238, 0.76);
			line-height: 1.6;
			font-size: 1rem;
			max-width: 36rem;
		}

		.hero-actions {
			gap: 12px;
			margin-top: 28px;
			flex-wrap: wrap;
		}

		.button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 14px 20px;
			border-radius: 12px;
			font-weight: 800;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			font-size: 0.78rem;
			text-decoration: none;
		}

		.button-primary {
			background: #f7f3ee;
			color: #151515;
		}

		.button-secondary {
			border: 1px solid rgba(255, 255, 255, 0.22);
			color: #f7f3ee;
			background: rgba(255, 255, 255, 0.04);
		}

		.hero-visual {
			position: relative;
			background:
				radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.2), transparent 22%),
				radial-gradient(circle at 70% 25%, rgba(255, 193, 100, 0.28), transparent 20%),
				linear-gradient(180deg, #0f1317 0%, #252a2d 100%);
			border: 1px solid rgba(18, 18, 18, 0.08);
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
		}

		.hero-visual::before {
			content: '';
			position: absolute;
			inset: auto 0 0 0;
			height: 36%;
			background: linear-gradient(180deg, transparent 0%, rgba(10, 10, 10, 0.25) 18%, rgba(10, 10, 10, 0.65));
		}

		.hero-visual::after {
			content: '';
			position: absolute;
			left: -5%;
			bottom: 12%;
			width: 82%;
			height: 16%;
			background: radial-gradient(circle at 30% 40%, #7a4e24 0 10%, transparent 11%),
				radial-gradient(circle at 50% 55%, #b87a43 0 14%, transparent 15%),
				radial-gradient(circle at 72% 48%, #5c341b 0 12%, transparent 13%);
			filter: blur(2px);
			transform: skewX(-18deg);
			opacity: 0.95;
		}

		.grain,
		.device,
		.cup {
			position: absolute;
			border-radius: 50%;
		}

		.grain-one {
			left: 8%;
			bottom: 18%;
			width: 52%;
			height: 26%;
			background: radial-gradient(circle at 35% 40%, #d1a06a, #7d4a22 62%, #20120b 100%);
			clip-path: polygon(10% 5%, 85% 0%, 100% 45%, 74% 100%, 14% 95%, 0 45%);
			opacity: 0.95;
		}

		.grain-two {
			left: 31%;
			bottom: 11%;
			width: 28%;
			height: 16%;
			background: radial-gradient(circle at 35% 40%, #c68647, #613616 70%);
			clip-path: polygon(0 35%, 50% 0, 100% 35%, 86% 100%, 13% 100%);
			opacity: 0.8;
		}

		.device-one {
			right: 22%;
			bottom: 23%;
			width: 12%;
			height: 20%;
			background: linear-gradient(180deg, #8f9496, #31383d);
			clip-path: polygon(35% 0, 65% 0, 83% 100%, 17% 100%);
		}

		.device-two {
			right: 10%;
			bottom: 23%;
			width: 11%;
			height: 24%;
			background: linear-gradient(180deg, #b4b1a8, #61615b);
			clip-path: polygon(16% 20%, 84% 20%, 70% 100%, 30% 100%);
		}

		.cup {
			right: 12%;
			bottom: 21%;
			width: 18%;
			height: 18%;
			border-radius: 18% 18% 48% 48%;
			background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), rgba(204, 214, 220, 0.55));
			box-shadow: inset 0 -14px 24px rgba(87, 58, 28, 0.35);
			transform: rotate(5deg);
		}

		.cup::before {
			content: '';
			position: absolute;
			right: -14%;
			top: 22%;
			width: 26%;
			height: 26%;
			border: 4px solid rgba(232, 233, 230, 0.75);
			border-left-color: transparent;
			border-radius: 50%;
		}

		.cup::after {
			content: '';
			position: absolute;
			inset: 22% 16% auto;
			height: 28%;
			border-radius: 50%;
			background: radial-gradient(circle, #523624 0, #20140f 100%);
		}

		.filters {
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			padding: 18px 18px;
			margin-top: 18px;
			background: rgba(255, 255, 255, 0.64);
			border: 1px solid rgba(18, 18, 18, 0.06);
		}

		.filters-toggle,
		.chip {
			border-radius: 10px;
			font-weight: 700;
			font-size: 0.75rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		.filters-toggle {
			border: 0;
			background: #111;
			color: white;
			padding: 12px 14px;
		}

		.chips {
			gap: 10px;
			flex-wrap: wrap;
		}

		.chip {
			padding: 10px 14px;
			background: rgba(18, 18, 18, 0.06);
			color: rgba(18, 18, 18, 0.72);
		}

		.view-icons {
			display: flex;
			gap: 14px;
			color: rgba(18, 18, 18, 0.7);
			font-size: 1rem;
		}

		.market {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 18px;
			padding: 38px 0 30px;
		}

		.card {
			background: rgba(255, 255, 255, 0.72);
			border-radius: 18px;
			overflow: hidden;
			border: 1px solid rgba(18, 18, 18, 0.08);
			box-shadow: 0 18px 40px rgba(18, 18, 18, 0.08);
		}

		.card-art {
			position: relative;
			height: 220px;
			padding: 14px;
			isolation: isolate;
		}

		.card-art::before {
			content: '';
			position: absolute;
			inset: 0;
			background:
				radial-gradient(circle at 50% 22%, rgba(255, 255, 255, 0.16), transparent 22%),
				linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(0, 0, 0, 0.16));
		}

		.card-label {
			position: relative;
			z-index: 1;
			display: inline-block;
			padding: 6px 8px;
			border-radius: 8px;
			background: rgba(8, 8, 8, 0.78);
			color: #f3efe8;
			font-size: 0.64rem;
			font-weight: 800;
			letter-spacing: 0.08em;
		}

		.art-shadow {
			position: absolute;
			inset: auto 12px 14px;
			height: 34px;
			border-radius: 999px;
			background: rgba(0, 0, 0, 0.28);
			filter: blur(12px);
		}

		.card-body {
			padding: 14px 14px 18px;
		}

		.meta-row,
		.price-row {
			justify-content: space-between;
			align-items: center;
			gap: 10px;
		}

		.origin {
			margin: 0;
			font-size: 0.68rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			color: #4e8f7d;
		}

		.score {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.15rem;
			color: #1e1e1e;
		}

		.card h2 {
			margin: 10px 0 8px;
			font-size: 1.22rem;
			line-height: 1.1;
			font-family: 'Space Grotesk', sans-serif;
		}

		.card-body .description {
			color: rgba(18, 18, 18, 0.64);
			margin: 0 0 18px;
		}

		.price-label {
			display: block;
			font-size: 0.64rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: rgba(18, 18, 18, 0.44);
			margin-bottom: 5px;
		}

		.price-row strong {
			font-size: 1.35rem;
		}

		.mini-button {
			width: 42px;
			height: 42px;
			border: 0;
			border-radius: 10px;
			background: #0f1112;
			color: white;
			font-size: 1rem;
		}

		.card-art.from-ruby-500 {
			background: linear-gradient(180deg, #2b5c45, #161f1b 50%, #7a3a20 100%);
		}

		.card-art.from-slate-700 {
			background: linear-gradient(180deg, #0f1112, #12222f 55%, #d8a760 100%);
		}

		.card-art.from-amber-900 {
			background: linear-gradient(180deg, #131516, #3b2418 50%, #b38a67 100%);
		}

		.card-art.from-emerald-950 {
			background: linear-gradient(180deg, #102221, #1b2d36 55%, #d18a4d 100%);
		}

		.integrity {
			display: grid;
			grid-template-columns: 1.2fr 0.8fr;
			gap: 28px;
			align-items: center;
			padding: 40px;
			background: linear-gradient(180deg, #151515, #1d1d1d);
			color: #f4f1eb;
		}

		.integrity-copy p {
			color: rgba(244, 241, 235, 0.72);
			font-size: 1.02rem;
		}

		.stats {
			display: grid;
			gap: 16px;
		}

		.stat {
			padding: 18px 18px 20px;
			border: 1px solid rgba(255, 255, 255, 0.24);
			border-radius: 14px;
			background: rgba(255, 255, 255, 0.02);
		}

		.stat span {
			display: block;
			font-size: 0.72rem;
			font-weight: 800;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: rgba(244, 241, 235, 0.65);
			margin-bottom: 10px;
		}

		.stat strong {
			font-size: clamp(2rem, 4vw, 3rem);
			font-family: 'Space Grotesk', sans-serif;
		}

		.footer {
			justify-content: space-between;
			gap: 24px;
			padding: 36px 8px 18px;
			align-items: flex-start;
			flex-wrap: wrap;
		}

		.footer > div {
			min-width: 180px;
		}

		.footer h3,
		.footer h4 {
			margin: 0 0 12px;
			font-family: 'Space Grotesk', sans-serif;
		}

		.footer p,
		.footer a {
			color: rgba(18, 18, 18, 0.72);
			display: block;
			margin: 0 0 8px;
		}

		@media (max-width: 980px) {
			.hero,
			.market,
			.integrity {
				grid-template-columns: 1fr;
			}

			nav {
				display: none;
			}

			.hero-copy,
			.hero-visual {
				min-height: 420px;
			}

			.market {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.integrity {
				padding: 30px;
			}
		}

		@media (max-width: 720px) {
			.page-shell {
				width: min(100% - 20px, 1280px);
				padding-top: 10px;
			}

			.topbar,
			.filters,
			.hero-copy,
			.hero-visual,
			.integrity {
				border-radius: 20px;
			}

			.hero-copy,
			.hero-visual {
				min-height: auto;
			}

			.hero-copy {
				padding: 28px 22px;
			}

			h1 {
				font-size: clamp(2.6rem, 15vw, 4.2rem);
			}

			.market {
				grid-template-columns: 1fr;
			}

			.filters {
				align-items: flex-start;
				flex-direction: column;
			}

			.view-icons {
				align-self: flex-end;
			}

			.card-art {
				height: 190px;
			}

			.footer {
				padding-inline: 0;
			}
		}
	</style>
</Layout>
