---
import { Icon } from 'astro-icon/components';
import '../../styles/globals.css';
import './login.css';

import { 
    getI18n,
    resolveLocale,
    readConsent 
} from '../../lib/i18n';

const consent = readConsent(Astro.cookies);
const locale = resolveLocale(Astro.cookies, Astro.url, Astro.request, consent);
const { m } = getI18n(locale);

---
<div class="auth-page">
    <h1>Iniciar Sesión</h1>
    <form class="auth-form">
        <div class="form-group">
            <div class="input-with-icon">
                <label for="email">
                    Correo Electrónico
                </label>
                <input 
                    id="email" 
                    type="email"
                    placeholder="Correo" 
                    required 
                    class="form-input"
                />
                <span class="input-icon">
                    <Icon name="email" class="icon"/> 
                </span>
            </div>
        </div>
        <div class="form-group">
            <div class="input-with-icon">
                <label for="password">Contraseña</label>
                <input 
                    id="password" 
                    type="password"
                    placeholder="Contraseña" 
                    required 
                    class="form-input"
                />
            </div>
        </div>
        <button type="submit" class="btn-login">Iniciar Sesión</button>
    </form>
    <div class="divider">
        <span></span>
        <span>o</span>
        <span></span>
    </div>
    <button class="btn-login-google">
        <Icon name="google" class="icon"/> 
        Continuar con Google
    </button>
    <p class="auth-link">
        <a href="/register">{}</a>
    </p>
</div>